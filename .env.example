# Zasky Phase 1 configuration.
# Copy this file to a protected location OUTSIDE the repository and fill it in.
# Never commit real values.

APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/zasky.db

# Switch transport. Use the server's own base URL, not the Gateway UI URL.
SWITCH_BASE_URL=http://localhost:8000
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=
SWITCH_CONNECTION_ID=
SWITCH_ROOM_ID=
OWNER_SWITCH_PARTICIPANT_ID=
# Optional override; normally derived from SWITCH_BASE_URL and SWITCH_AGENT_ID.
# SWITCH_WS_URL=ws://localhost:8000/agents/<agent-id>/connection/ws

# Private health server. Bind localhost only.
HEALTH_BIND_HOST=127.0.0.1
HEALTH_BIND_PORT=8099
MAX_MESSAGE_CHARS=8000

# Bounded reconnect backoff.
SWITCH_RECONNECT_MIN_SECONDS=1
SWITCH_RECONNECT_MAX_SECONDS=30

# Planning profile (operator-confirmed values override these staging defaults).
TIMEZONE=Africa/Lagos
CAPACITY_PCT=65
WEEK_START_DAY=monday
DAILY_TASK_LIMIT=3
TRANSITION_BUFFER_MIN=10
MORNING_PREP_MIN=30
COMMUTE_BUFFER_MIN=0
WEEKLY_AVAILABILITY_JSON={}
MORNING_PROMPT_TIME=07:00
EVENING_PROMPT_TIME=20:00
REMINDERS_ENABLED=false
TIMEBOX_CHECKINS_ENABLED=false
