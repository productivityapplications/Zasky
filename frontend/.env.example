# Public base URL of the Zasky dashboard API on the VPS.
# The Next.js server proxy reads this (and ZASKY_API_URL if set).
NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP:8100

# Optional server-side override for the proxy.
# ZASKY_API_URL=http://YOUR_VPS_IP:8100

# Server-only bearer token. Never prefix this with NEXT_PUBLIC_.
# Copy the value of DASHBOARD_API_KEY from /root/Zasky-secrets/zasky.env.
ZASKY_DASHBOARD_TOKEN=
